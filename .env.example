# Copy to .env and fill in the values. See ReadMe.md -> Setup and Installation.

# Cluster names and descriptions, and the topics of the week, are written by Claude through the Claude Code CLI
# (`claude -p`) on a Claude subscription. Logged in locally, it needs nothing here; in a container, set the token
# from `claude setup-token`:
# CLAUDE_CODE_OAUTH_TOKEN=

# API key for OpenAlex (free account at openalex.org -> openalex.org/settings/api)
OPENALEX_API_KEY=

# Database; defaults to a local SQLite file (local.db). Production uses Postgres:
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/thesis

# Flask configuration
FLASK_PORT=5001
